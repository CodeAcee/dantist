---
// Cookie consent for analytics: rendered only when PUBLIC_GA_ID is set. Google Analytics loads
// after "Accept" and never before; "Decline" is remembered and nothing is loaded at all.
const GA = import.meta.env.PUBLIC_GA_ID || "";
const { text, accept, decline } = Astro.props as { text: string; accept: string; decline: string };
---
{GA && (
  <>
    <aside class="cookie glass" id="cookie" hidden>
      <p>{text}</p>
      <div class="cookie__row">
        <button class="btn btn--ink" id="ck-yes">{accept}</button>
        <button class="btn btn--ghost" id="ck-no">{decline}</button>
      </div>
    </aside>
    <script is:inline define:vars={{ GA }}>
      (() => {
        let c = null; try { c = localStorage.getItem('cookies'); } catch {}
        const load = () => {
          const s = document.createElement('script'); s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA; s.async = true; document.head.append(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag('js', new Date()); gtag('config', GA);
        };
        if (c === 'yes') return load();
        if (c === 'no') return;
        const bar = document.getElementById('cookie');
        const close = v => { try { localStorage.setItem('cookies', v); } catch {} bar.classList.remove('show'); setTimeout(() => bar.remove(), 500); };
        document.getElementById('ck-yes').addEventListener('click', () => { close('yes'); load(); });
        document.getElementById('ck-no').addEventListener('click', () => close('no'));
        setTimeout(() => { bar.hidden = false; requestAnimationFrame(() => bar.classList.add('show')); }, 1200);
      })();
    </script>
  </>
)}
