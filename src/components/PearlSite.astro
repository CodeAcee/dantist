---
// The pearl / liquid-glass site (the 04 direction) as one component: markup from the approved demo,
// copy from i18n/pearl. Services, prices, the case, doctors and reviews come only from Sanity.
// Regenerate from the demo with: python3 tools/gen-pearl.py (see the redesign branch history).
import "../styles/pearl.css";
import "../styles/pearl-site.css";
import SeoHead from "./SeoHead.astro";
import { getContent, getServicePages, getAnnouncement } from "../lib/content";
import AnnounceBar from "./AnnounceBar.astro";
import { translations } from "../i18n/translations";
import { pearl, clinicLinks as L, icons, type PearlLang } from "../i18n/pearl";
import { PAGE_UI } from "../i18n/services";

interface Props { lang: PearlLang; }
const { lang } = Astro.props;
const t = pearl[lang];
const tr = translations[lang];
const data = await getContent(lang);
const ui = PAGE_UI[lang];
const tel = "tel:" + ui.phone.replace(/[^+\d]/g, "");
const home = lang === "en" ? import.meta.env.BASE_URL.replace(/\/?$/, "/") + "en/" : import.meta.env.BASE_URL.replace(/\/?$/, "/");

const pages = await getServicePages();
const announce = await getAnnouncement(lang);
const svcAll = data.services;
const svc = svcAll.slice(0, 6);
const reviews = data.reviews.slice(0, 8);
const team = data.team;
const founder = team[0];
const cases = data.cases.filter((c) => c.beforeImg && c.afterImg);
const kase = cases[0];

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const P = base + "pearl/";
const photos = ["photo-f29462631-960.jpg", "photo-f123751291-960.jpg", "photo-f156042973-960.jpg", "photo-f190774253-960.jpg", "photo-f14101125-960.jpg", "photo-f130333575-960.jpg"].map((f) => P + "img/" + f);
const caseBefore = kase?.beforeImg;
const caseAfter = kase?.afterImg;
const caseData = JSON.stringify(cases.map((c) => ({ b: c.beforeImg, a: c.afterImg, bt: c.before ?? "", at: c.after ?? "" })));
const slides = [[572, 1163], [598, 1214], [617, 1242], [592, 922], [842, 1696]];
const importmap = JSON.stringify({ imports: { three: P + "vendor/three.module.min.js", "three/addons/": P + "vendor/" } });
const CONTACT = import.meta.env.PUBLIC_CONTACT_WORKER_URL || "";
const langUk = base, langEn = base + "en/";
const bootstrap = `window.__PB=${JSON.stringify(P)};window.__CONTACT=${JSON.stringify(CONTACT)};document.documentElement.classList.add("js")`;
---
<!doctype html>
<html lang={tr.htmlLang}>
<head>
<SeoHead title={tr.seo.title} description={tr.seo.description} keywords={tr.seo.keywords} lang={tr.htmlLang} ogLocale={tr.ogLocale} />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..700&family=Playfair+Display:ital,wght@1,400;1,500&display=swap" rel="stylesheet">
<link rel="preload" href={P + "tooth.bin"} as="fetch" crossorigin media="(min-width: 900px)">
<link rel="preload" href={P + "slides/act0.webp"} as="image" media="(max-width: 899px)">
<script type="importmap" is:inline set:html={importmap} />
<script is:inline set:html={bootstrap} />
</head>
<body>
<canvas id="pearl" aria-hidden="true"></canvas>
<a class="skip" href="#booking">{t.nav.bookFull}</a>

<header class="nav">
  <a class="logo" href={base}><i aria-hidden="true"></i>Chirkova Dentist</a>
  <ul>
    <li><a href="#services">{t.nav.services}</a></li>
    <li><a href="#cases">{t.nav.results}</a></li>
    <li><a href="#prices">{t.nav.prices}</a></li>
    <li><a href="#reviews">{t.nav.reviews}</a></li>
    <li><a href="#visit">{t.nav.contacts}</a></li>
  </ul>
  <div class="nav__end">
    <nav class="lang" aria-label={t.nav.langLabel}>{lang === "uk" ? <span aria-current="true">UA</span> : <a href={langUk} hreflang="uk">UA</a>}{lang === "en" ? <span aria-current="true">EN</span> : <a href={langEn} hreflang="en">EN</a>}</nav>
    <a class="btn btn--ink" href="#booking">{t.nav.book}</a>
  </div>
</header>
<AnnounceBar a={announce} base={base} closeLabel={t.announceClose} />

<main id="top">
  <section class="story" id="story" aria-label={t.nav.services}>
    <div class="stage">
      <div class="glow" aria-hidden="true"></div>
      <canvas id="tooth" aria-hidden="true"></canvas>
      <div class="progress" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
      <div class="acts">
        <div class="act act--hero is-on" data-act="0">
          <div class="meta"><span class="chip"><i></i>{t.hero.chipHours}</span><span class="chip">{t.hero.chipAddr}</span></div>
          <h1 style="margin-top: 18px">{t.hero.h1pre} <em class="s">{t.hero.h1em}</em></h1>
          <p class="lead">{t.hero.lead}</p>
          <img class="act__img" src={P + "slides/act0.webp"} width={slides[0][0]} height={slides[0][1]} alt="" decoding="async" fetchpriority="high">
          <div class="row"><a class="btn btn--ink" href="#booking">{t.nav.bookFull}</a><a class="btn btn--ghost" href="#prices">{t.hero.ctaPrices}</a></div>
        </div>
        {t.acts.map((a, i) => (
          <div class="act" data-act={i + 1}>
            <img class="act__img" src={P + `slides/act${i + 1}.webp`} width={slides[i + 1][0]} height={slides[i + 1][1]} alt="" decoding="async" loading="lazy">
            <span class="act__n"><b>{"0" + (i + 1)}</b>{a.tag}</span>
            <h2>{a.h[0]}<em class="s">{a.h[1]}</em>{a.h[2]}</h2>
            <p>{a.p}</p>
            {a.price && <span class="price">{a.price}</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="hs" id="services" aria-labelledby="svc-h">
    <div class="hs__stick">
      <div class="wrap head">
        <h2 id="svc-h" class="split">{t.services.h}</h2>
        <p data-rv>{t.services.note}</p>
      </div>
      <div class="hs__track" id="hs-track">
        {svc.map((s, i) => (
          <a class="svc" href={s.page ? home + s.page : "#prices"}>
            <figure><img src={photos[i % photos.length]} width="960" height="720" alt={s.name} loading="lazy"><span class="svc__n">{s.num}</span></figure>
            <div class="svc__b"><h3>{s.name}</h3><p>{s.desc}</p><span class="from">{s.price}</span>{s.page && <span class="svc__more">{t.svcMore} →</span>}</div>
          </a>
        ))}
      </div>
      <div class="hs__bar" aria-hidden="true"><i id="hs-bar"></i></div>
    </div>
  </section>

  {kase && caseBefore && caseAfter && <section class="blk" id="cases" aria-labelledby="cases-h">
    <div class="wrap">
      <div class="head">
        <h2 id="cases-h" class="split">{t.cases.h}</h2>
        <p data-rv>{t.cases.note}</p>
      </div>
      {cases.length > 1 && (
        <div class="case-tabs" role="tablist" aria-label={t.cases.h} data-rv>
          {cases.map((c, i) => (
            <button class="chip case-tab" type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-case={i}>
              {c.treatment}{c.duration && <small> · {c.duration}</small>}
            </button>
          ))}
        </div>
      )}
      <div class="ba" id="ba" data-rv style="--pos: 50%" data-cases={caseData}>
        <img src={caseBefore} width="820" height="615" alt={kase?.before ?? ""}>
        <img class="ba__after" src={caseAfter} width="820" height="615" alt={kase?.after ?? ""}>
        <span class="ba__tag ba__tag--l">{t.cases.before}</span><span class="ba__tag ba__tag--r">{t.cases.after}</span>
        <span class="ba__line" aria-hidden="true"></span><span class="ba__knob" aria-hidden="true">⇆</span>
        <input type="range" min="0" max="100" value="50" aria-label={t.cases.h}>
      </div>
      {(kase.before || kase.after) && <p class="case-note" id="case-note" data-rv><span>{t.cases.before}: <b id="case-bt">{kase.before}</b></span><span>{t.cases.after}: <b id="case-at">{kase.after}</b></span></p>}
      <div class="facts">
        {t.facts.map((f, i) => (
          <div class="fact" data-rv style={`--i:${i}`}><b {...(f.count ? { "data-count": f.count, "data-suffix": f.suffix || "" } : {})}>{f.b}</b><span>{f.label}</span></div>
        ))}
      </div>
    </div>
  </section>}

  <section class="blk" id="prices" aria-labelledby="prices-h">
    <div class="wrap">
      <div class="head">
        <h2 id="prices-h" class="split">{t.prices.h}</h2>
        <p data-rv>{t.prices.note}</p>
      </div>
      <div class="pc">
        {svcAll.map((s, i) => (
          <details open={i === 0}>
            <summary><b>{s.name}</b><span>{s.price}</span><i aria-hidden="true">+</i></summary>
            <ul>{s.items.map((it) => <li><span>{it.name}</span><span>{it.price}</span></li>)}</ul>
          </details>
        ))}
      </div>
    </div>
  </section>

  {pages.length > 0 && <section class="blk" id="pages" aria-labelledby="pages-h">
    <div class="wrap">
      <div class="head">
        <h2 id="pages-h" class="split">{t.pages.h}</h2>
        <p data-rv>{t.pages.note}</p>
      </div>
      <div class="pages">
        {pages.map((pg, i) => (
          <a class="page-card glass" href={home + pg.slug} data-rv style={`--i:${i % 4}`}>
            <span class="chip">{pg[lang].eyebrow}</span>
            <h3>{pg[lang].name}</h3>
            <p>{pg[lang].intro}</p>
            <span class="more">{t.pages.more} <i aria-hidden="true">→</i></span>
          </a>
        ))}
        {pages.length % 3 !== 0 && (
          <a class="page-card page-card--ask glass" href="#booking" data-rv style={`--i:${pages.length % 4}`}>
            <span class="chip">{t.pages.askTag}</span>
            <h3>{t.pages.askH}</h3>
            <p>{t.pages.askP}</p>
            <span class="more">{t.pages.askMore} <i aria-hidden="true">→</i></span>
          </a>
        )}
      </div>
    </div>
  </section>}

  {reviews.length > 0 && <section class="blk" id="reviews" aria-labelledby="reviews-h" style="padding-bottom: 60px">
    <div class="wrap head">
      <h2 id="reviews-h" class="split">{t.reviews.h}</h2>
      <p class="g49" data-rv><b>4,9</b><span>{t.reviews.badge}</span></p>
    </div>
    <div class="rv" tabindex="0" aria-label={t.reviews.h}>
      {reviews.map((r) => (
        <figure>
          <blockquote>«{r.text}»</blockquote>
          <footer><span class="av">{r.initials}</span><span>{r.name}<br/>{t.reviews.patient} {r.age}</span><span class="st" aria-label={t.reviews.starsLabel}>★★★★★</span></footer>
        </figure>
      ))}
    </div>
  </section>}

  {founder && <section class="blk" id="team" aria-labelledby="team-h">
    <div class="wrap founder">
      <div>
        <p class="sr-only" id="team-h">{t.team.tag}</p>
        <blockquote data-rv>«{founder.bio}»</blockquote>
        <div class="who" data-rv style="--i:1">
          {team.map((d) => (
            <div class="doc"><span>{d.name} · {d.title}</span><span>{d.years} {d.yearsLabel.toLowerCase()}</span></div>
          ))}
        </div>
      </div>
      <div class="orbpic" data-rv style="--i:2"><img src={founder.img || P + "img/photo-f22521718-960.jpg"} width="960" height="798" alt={founder.img ? founder.name : ""} loading="lazy"></div>
    </div>
  </section>}

  <section class="blk" id="visit" aria-labelledby="visit-h">
    <div class="wrap">
      <div class="head">
        <h2 id="visit-h" class="split">{t.visit.h}</h2>
        <p data-rv>{t.visit.note}</p>
      </div>
      <div class="visit">
        <div class="visit__info glass" data-rv>
          <address class="visit__addr">{ui.address}</address>
          <dl class="hours">{t.booking.hours.map(([d, h]) => <><dt>{d}</dt><dd>{h}</dd></>)}</dl>
          <div class="visit__btns">
            <a class="btn btn--ink" href={L.mapLink} target="_blank" rel="noopener">{t.visit.route}</a>
            <a class="btn btn--ghost" href={tel}>{ui.phone}</a>
          </div>
          <div>
            <p style="font-weight: 600; margin-bottom: 10px">{t.visit.follow}</p>
            <div class="socials">
              <a class="soc-btn" href={L.tiktok} target="_blank" rel="noopener"><Fragment set:html={icons.tiktok} /><span>TikTok<small>{L.handle}</small></span></a>
              <a class="soc-btn" href={L.instagram} target="_blank" rel="noopener"><Fragment set:html={icons.instagram} /><span>Instagram<small>{L.handle}</small></span></a>
            </div>
          </div>
        </div>
        <div class="visit__map glass" data-rv style="--i:1">
          <div class="map-gate" id="map-gate" data-src={L.mapEmbed} data-title={t.visit.mapTitle}>
            <div>
              <div class="map-gate__pin" aria-hidden="true"></div>
              <button class="btn btn--ink" type="button">{t.visit.mapShow}</button>
              <p>{t.visit.mapNote}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="blk" id="booking" aria-labelledby="booking-h">
    <div class="wrap book">
      <div>
        <h2 id="booking-h" class="split">{t.booking.h}</h2>
        <p style="margin-top: 18px; max-width: 34ch" data-rv>{t.booking.note}</p>
        <p data-rv style="margin-top: 22px"><a class="btn btn--ghost" href={tel}>{ui.phone}</a></p>
      </div>
      <form class="form" id="form" novalidate data-rv data-fix1={t.booking.fix1} data-fix2={t.booking.fix2} data-sending={t.booking.sending} data-ok={t.booking.ok} data-err={t.booking.err}>
        <div class="field"><label for="f-name">{t.booking.name}</label><input id="f-name" name="name" autocomplete="name" required aria-describedby="e-name"><p class="field__err" id="e-name" hidden>{t.booking.nameErr}</p></div>
        <div class="field"><label for="f-phone">{t.booking.phone}</label><input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="e-phone"><p class="field__err" id="e-phone" hidden>{t.booking.phoneErr}</p></div>
        <div class="field"><label for="f-service">{t.booking.service}</label><select id="f-service" name="service"><option value="">{t.booking.servicePlaceholder}</option>{svcAll.map((s) => <option>{s.name}</option>)}</select></div>
        <div class="field"><label for="f-note">{t.booking.note2}</label><textarea id="f-note" name="note" placeholder={t.booking.notePlaceholder}></textarea></div>
        <button class="btn btn--ink" type="submit">{t.booking.submit}</button>
        <p role="status" id="f-status" style="font-size: 14px; color: var(--muted)">{t.booking.idle}</p>
      </form>
    </div>
  </section>
</main>

<footer class="end">
  <div class="wrap">
    <div class="end__social">
      <div class="socials">
        <a class="soc-btn" href={L.tiktok} target="_blank" rel="noopener"><Fragment set:html={icons.tiktok} /><span>TikTok<small>{L.handle}</small></span></a>
        <a class="soc-btn" href={L.instagram} target="_blank" rel="noopener"><Fragment set:html={icons.instagram} /><span>Instagram<small>{L.handle}</small></span></a>
      </div>
      <nav class="lang" aria-label={t.nav.langLabel}>{lang === "uk" ? <span aria-current="true">UA</span> : <a href={langUk} hreflang="uk">UA</a>}{lang === "en" ? <span aria-current="true">EN</span> : <a href={langEn} hreflang="en">EN</a>}</nav>
    </div>
    <p class="word" id="word" aria-hidden="true">Chirkova</p>
    <div class="end__row">
      <span>© {new Date().getFullYear()} Chirkova Dentist · {ui.address} · <a href={tel}>{ui.phone}</a></span>
      <span>{pages.map((s) => <a href={home + s.slug}>{s[lang].name}</a>)}</span>
    </div>
  </div>
</footer>

<div class="bar" id="bar"><a class="btn btn--ink" href="#booking">{t.nav.bookFull}</a></div>

<script is:inline type="module">const PB = window.__PB || '/';
const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
const clamp = (v, a = 0, b = 1) => Math.min(b, Math.max(a, v));
const ease = t => 1 - Math.pow(1 - t, 3);
const seg = (p, a, b) => clamp((p - a) / (b - a));

/* ---------- scroll progress of the story ---------- */
const story = document.getElementById('story');
const acts = [...document.querySelectorAll('.act')];
const pips = [...document.querySelectorAll('.progress i')];
const ranges = [[0, .16], [.16, .38], [.38, .58], [.58, .8], [.8, 1.01]];
let P = 0;
function storyProgress() {
  const r = story.getBoundingClientRect();
  const total = story.offsetHeight - innerHeight;
  P = total > 0 ? clamp(-r.top / total) : 0;
  const k = ranges.findIndex(([a, b]) => P >= a && P < b);
  acts.forEach((a, i) => a.classList.toggle('is-on', i === k));
  pips.forEach((p, i) => p.classList.toggle('is-on', i === k));
}

/* ---------- 3D tooth (tooth.js) ---------- */
if (matchMedia('(min-width: 900px)').matches) try {
  const { mountTooth } = await import(PB + 'tooth.js');
  window.__tooth = await mountTooth(document.getElementById('tooth'), { progress: () => P, still, host: story, src: PB + 'tooth.bin' });
} catch (e) { console.warn('tooth', e); document.documentElement.classList.add('no-gl'); }

/* ---------- services: vertical scroll drives the track ---------- */
const hs = document.getElementById('services'), track = document.getElementById('hs-track'), bar = document.getElementById('hs-bar');
function hsSize() { if (still) return; const extra = Math.max(0, track.scrollWidth - innerWidth); hs.style.setProperty('--hs-h', `calc(100svh + ${extra}px)`); }
function hsMove() {
  if (still) return;
  const r = hs.getBoundingClientRect(), total = hs.offsetHeight - innerHeight;
  const p = total > 0 ? clamp(-r.top / total) : 0;
  track.style.transform = `translate3d(${-p * Math.max(0, track.scrollWidth - innerWidth)}px,0,0)`;
  bar.style.setProperty('--p', p);
}

/* ---------- reveals, letters, counts ---------- */
document.querySelectorAll('.split').forEach(el => {
  let c = 0;
  el.innerHTML = el.textContent.split(' ').map(w => `<span class="w">${[...w].map(ch => `<span class="ch" style="--c:${c++}">${ch}</span>`).join('')}</span>`).join(' ');
  el.setAttribute('aria-label', el.textContent);
});
const io = new IntersectionObserver(es => es.forEach(e => {
  if (!e.isIntersecting) return;
  e.target.classList.add('in'); io.unobserve(e.target);
  const n = e.target.querySelector('[data-count]');
  if (n && !still) { const end = +n.dataset.count, suf = n.dataset.suffix || '', t0 = performance.now(); (function tick(now) { const k = ease(clamp((now - t0) / 1400)); n.textContent = Math.round(end * k) + suf; if (k < 1) requestAnimationFrame(tick); })(t0); }
}), { rootMargin: '0px 0px -12% 0px' });
document.querySelectorAll('[data-rv], .split').forEach(el => io.observe(el));

/* ---------- before and after ---------- */
const ba = document.getElementById('ba'), range = ba.querySelector('input');
range.addEventListener('input', () => ba.style.setProperty('--pos', range.value + '%'));
// several cases: the tabs swap the pair under the slider
const CASES = JSON.parse(ba.dataset.cases || '[]');
document.querySelectorAll('.case-tab').forEach(tab => tab.addEventListener('click', () => {
  const c = CASES[+tab.dataset.case]; if (!c) return;
  document.querySelectorAll('.case-tab').forEach(x => x.setAttribute('aria-selected', String(x === tab)));
  const [b, a] = ba.querySelectorAll('img');
  b.src = c.b; b.alt = c.bt; a.src = c.a; a.alt = c.at;
  range.value = 50; ba.style.setProperty('--pos', '50%');
  const bt = document.getElementById('case-bt'), at = document.getElementById('case-at');
  if (bt) bt.textContent = c.bt; if (at) at.textContent = c.at;
}));

/* ---------- phone bar: after the story's first screen, never over the form ---------- */
const barEl = document.getElementById('bar'), booking = document.getElementById('booking');
function barShow() { const b = booking.getBoundingClientRect(); barEl.classList.toggle('show', scrollY > innerHeight * .9 && !(b.top < innerHeight && b.bottom > 0)); }

/* ---------- form: errors under fields, mailto stand-in ---------- */
const formEl = document.getElementById('form'), statusEl = document.getElementById('f-status'), FD = formEl.dataset;
formEl.addEventListener('submit', async e => {
  e.preventDefault();
  let bad = [];
  [['f-name', 'e-name', v => v.trim().length > 1], ['f-phone', 'e-phone', v => /^\+?3?8?0\d{9}$/.test(v.replace(/[\s()-]/g, ''))]].forEach(([f, er, ok]) => {
    const i = document.getElementById(f), m = document.getElementById(er), good = ok(i.value);
    i.setAttribute('aria-invalid', !good); m.hidden = good; if (!good) bad.push(i);
  });
  if (bad.length) { bad[0].focus(); statusEl.textContent = bad.length === 1 ? FD.fix1 : FD.fix2; return; }
  const btn = formEl.querySelector('button[type=submit]');
  btn.disabled = true; statusEl.textContent = FD.sending;
  try {
    if (!window.__CONTACT) throw new Error('no endpoint');
    const res = await fetch(window.__CONTACT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({
      name: document.getElementById('f-name').value.trim(),
      phone: document.getElementById('f-phone').value.trim(),
      service: document.getElementById('f-service').value || undefined,
      note: document.getElementById('f-note').value.trim() || undefined,
    }) });
    if (!res.ok) throw new Error('bad status');
    statusEl.textContent = FD.ok; formEl.reset();
  } catch (err) { console.warn('form', err); statusEl.textContent = FD.err; }
  btn.disabled = false;
});


/* ---------- pearl ground, liquid glass, the name ---------- */
import(PB + 'pearl.js').then(m => m.mountPearl(document.getElementById('pearl'))).catch(e => console.warn('pearl', e));
document.querySelectorAll('.nav, .chip, .btn--ghost, .act .price, .svc, .fact, .pc, .rv figure, .form, .bar, .demo, .glass').forEach(el => el.classList.add('lg'));
let gq = null;
addEventListener('pointermove', e => {
  if (gq) return; gq = requestAnimationFrame(() => {
    gq = null;
    const g = e.target.closest && e.target.closest('.lg');
    if (g) { const r = g.getBoundingClientRect(); g.style.setProperty('--mx', (e.clientX - r.left) + 'px'); g.style.setProperty('--my', (e.clientY - r.top) + 'px'); g.style.setProperty('--ang', (Math.atan2(e.clientY - r.top - r.height / 2, e.clientX - r.left - r.width / 2) * 57.3 + 90) + 'deg'); }
  });
}, { passive: true });
const word = document.getElementById('word');
if (word) {
  let on = false, idle = 0, wq = null;
  const set = (x, y) => {
    const r = word.getBoundingClientRect(), fx = (x - r.left) / r.width, fy = (y - r.top) / r.height;
    word.style.setProperty('--mx', (fx * 100) + '%'); word.style.setProperty('--my', (fy * 100) + '%');
    word.style.setProperty('--h', ((fx - .5) * 90) + 'deg');
    if (!still) { word.style.setProperty('--ry', (clamp(fx, -.2, 1.2) - .5) * 14 + 'deg'); word.style.setProperty('--rx', (.5 - clamp(fy, -1, 2)) * 10 + 'deg'); }
  };
  addEventListener('pointermove', e => { if (!on || wq) return; wq = requestAnimationFrame(() => { wq = null; idle = performance.now(); set(e.clientX, e.clientY); }); }, { passive: true });
  addEventListener('touchmove', e => { const p = e.touches[0]; if (on && p) { idle = performance.now(); set(p.clientX, p.clientY); } }, { passive: true });
  new IntersectionObserver(([e]) => { on = e.isIntersecting; if (on && !still) drift(); }).observe(word);
  // with no pointer on it, the highlight drifts slowly across the letters
  function drift(now = performance.now()) {
    if (!on) return;
    if (now - idle > 2500) { const r = word.getBoundingClientRect(), k = now / 2600; set(r.left + r.width * (.5 + .45 * Math.sin(k)), r.top + r.height * (.4 + .25 * Math.cos(k * 1.3))); }
    requestAnimationFrame(drift);
  }
}

let queued = false;
function onScroll() { storyProgress(); hsMove(); barShow(); }
addEventListener('scroll', () => { if (queued) return; queued = true; requestAnimationFrame(() => { queued = false; onScroll(); }); }, { passive: true });
addEventListener('resize', () => { hsSize(); onScroll(); });
hsSize(); onScroll();
// ?at=0.5 scrolls to that share of the story (for review shots)
const at = new URLSearchParams(location.search).get('at');
if (at !== null) { scrollTo({ top: (story.offsetHeight - innerHeight) * +at, behavior: 'instant' }); onScroll(); }
// the map: Google Maps only after a click, so no third-party cookies before it
const gate = document.getElementById('map-gate');
if (gate) gate.querySelector('button').addEventListener('click', () => {
  const f = document.createElement('iframe');
  f.src = gate.dataset.src; f.title = gate.dataset.title; f.loading = 'lazy'; f.allowFullscreen = true;
  f.referrerPolicy = 'no-referrer-when-downgrade';
  gate.replaceWith(f);
});</script>
</body>
