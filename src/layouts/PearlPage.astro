---
// The shell of the pearl inner pages (services): the pearl ground, the glass nav, the footer with the
// pearl name. Styles come from styles/pearl.css, shared with the home page.
import "../styles/pearl.css";
import SeoHead from "../components/SeoHead.astro";
import { PAGE_UI, type Lang, type Service } from "../i18n/services";
import { pearl } from "../i18n/pearl";

interface Props {
  title: string;
  description: string;
  keywords?: string;
  lang?: Lang;
  ogLocale?: string;
  extraSchema?: Record<string, unknown>[];
  pages: Service[];
}
const { title, description, keywords, lang = "uk", ogLocale = "uk_UA", extraSchema = [], pages } = Astro.props;

const ui = PAGE_UI[lang];
const t = pearl[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const P = base + "pearl/";
const path = Astro.url.pathname;
const rel = path.startsWith(base) ? path.slice(base.length) : path.replace(/^\//, "");
const stripped = rel.replace(/\/$/, "");
const slugPart = stripped === "en" ? "" : stripped.startsWith("en/") ? stripped.slice(3) : stripped;
const otherLangHref = lang === "en" ? base + slugPart : base + "en/" + slugPart;
const home = lang === "en" ? base + "en/" : base;
const bootstrap = `window.__PB=${JSON.stringify(P)};document.documentElement.classList.add("js")`;
---
<!doctype html>
<html lang={lang}>
<head>
  <SeoHead title={title} description={description} keywords={keywords} lang={lang} ogLocale={ogLocale} extraSchema={extraSchema} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..700&family=Playfair+Display:ital,wght@1,400;1,500&display=swap" rel="stylesheet">
  <script is:inline set:html={bootstrap} />
</head>
<body>
  <canvas id="pearl" aria-hidden="true"></canvas>
  <a class="skip" href="#main">{ui.home}</a>

  <header class="nav">
    <a class="logo" href={home}><i aria-hidden="true"></i>Chirkova Dentist</a>
    <ul>
      <li><a href={home + "#services"}>{t.nav.services}</a></li>
      <li><a href={home + "#cases"}>{t.nav.results}</a></li>
      <li><a href={home + "#prices"}>{t.nav.prices}</a></li>
      <li><a href={otherLangHref}>{lang === "en" ? "Укр" : "EN"}</a></li>
    </ul>
    <a class="btn btn--ink" href={home + "#booking"}>{t.nav.book}</a>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="end">
    <div class="wrap">
      <div class="pg-foot">
        <div><b>{ui.contactsTitle}</b><a href={"tel:" + ui.phone.replace(/[^+\d]/g, "")}>{ui.phone}</a><span>{ui.address}</span><span>{ui.hours}</span></div>
        <div><b>{ui.services}</b>{pages.map((s) => <a href={home + s.slug}>{s[lang].name}</a>)}</div>
      </div>
      <p class="word" id="word" aria-hidden="true">Chirkova</p>
      <div class="end__row">
        <span>© {new Date().getFullYear()} Chirkova Dentist · {ui.rights}</span>
        <span><a href="https://www.tiktok.com/@mad__dentist" target="_blank" rel="noopener">TikTok</a><a href="https://www.instagram.com/mad__dentist/" target="_blank" rel="noopener">Instagram</a></span>
      </div>
    </div>
  </footer>

  <div class="bar" id="bar"><a class="btn btn--ink" href={home + "#booking"}>{t.nav.bookFull}</a></div>

  <script is:inline type="module" src={P + "chrome.js"}></script>

  <style is:global>
    .pg-foot { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding-bottom: 40px; border-bottom: 1px solid var(--line); margin-bottom: 20px; }
    .pg-foot div { display: grid; gap: 8px; align-content: start; font-size: 15px; color: var(--muted); }
    .pg-foot b { color: var(--ink); font-weight: 600; }
    .pg-foot a { text-decoration: none; }
    .pg-foot a:hover { color: var(--ink); }
    @media (max-width: 699px) { .pg-foot { grid-template-columns: 1fr; } }
  </style>
</body>
</html>
